{
  "annotations": {
    "list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"}]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["events", "kafka", "processor"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Event Processing Platform",
  "uid": "event-processing-platform",
  "version": 3,
  "panels": [

    {
      "id": 1,
      "title": "Throughput geral (msgs/s)",
      "description": "Taxa de entrada vs saída por categoria. Recebidos deve ≈ Processados + Inválidos + Duplicados.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": true, "axisBorderShow": false, "stacking": {"group": "A", "mode": "none"}},
          "unit": "reqps", "min": 0
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "Recebidos"},   "properties": [{"id": "color", "value": {"fixedColor": "blue",     "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "Processados"}, "properties": [{"id": "color", "value": {"fixedColor": "green",    "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "Inválidos"},   "properties": [{"id": "color", "value": {"fixedColor": "orange",   "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "Duplicados"},  "properties": [{"id": "color", "value": {"fixedColor": "yellow",   "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "Falhos"},      "properties": [{"id": "color", "value": {"fixedColor": "red",      "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "DLQ"},         "properties": [{"id": "color", "value": {"fixedColor": "dark-red", "mode": "fixed"}}]}
        ]
      },
      "options": {
        "legend": {"calcs": ["lastNotNull", "max", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(events_received_total[1m])",                                                         "legendFormat": "Recebidos",   "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(events_processed_total{tenant_id!=\"\"}[1m]))",                                   "legendFormat": "Processados", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(events_invalid_total{reason!=\"\"}[1m]))",                                        "legendFormat": "Inválidos",   "refId": "C"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(events_duplicated_total{tenant_id!=\"\"}[1m]))",                                  "legendFormat": "Duplicados",  "refId": "D"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(events_failed_total{tenant_id!=\"\"}[1m]))",                                      "legendFormat": "Falhos",      "refId": "E"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(events_sent_to_dlq_total{reason!=\"\"}[1m]))",                                    "legendFormat": "DLQ",         "refId": "F"}
      ]
    },

    {
      "id": 2, "title": "msgs/s (entrada)",
      "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}, {"color": "green", "value": 5}]}, "mappings": []}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(events_received_total[1m])", "legendFormat": "recebidos/s", "refId": "A"}]
    },

    {
      "id": 3, "title": "msgs/s (processados)",
      "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 4, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}, {"color": "green", "value": 5}]}, "mappings": []}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(events_processed_total{tenant_id!=\"\"}[1m]))", "legendFormat": "processados/s", "refId": "A"}]
    },

    {
      "id": 4, "title": "Mensagens em processamento",
      "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 8, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "orange", "value": 15}]}, "mappings": []}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "events_in_flight", "legendFormat": "in-flight", "refId": "A"}]
    },

    {
      "id": 5, "title": "Consumer lag (msgs na fila)",
      "description": "Mensagens publicadas no Kafka mas ainda não consumidas. Requer kafka-exporter rodando (`docker compose up -d`).",
      "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "noValue": "aguardando exporter", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 100}, {"color": "red", "value": 1000}]}, "mappings": []}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(kafka_consumergroup_lag{consumergroup=\"event-processor\"})", "legendFormat": "lag", "refId": "A"}]
    },

    {
      "id": 6, "title": "Taxa de sucesso",
      "type": "gauge", "gridPos": {"h": 4, "w": 4, "x": 16, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 80}, {"color": "green", "value": 95}]}, "mappings": []}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "showThresholdMarkers": true},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(events_processed_total{tenant_id!=\"\"}[2m])) / rate(events_received_total[2m]) * 100",
          "legendFormat": "sucesso %", "refId": "A"
        }
      ]
    },

    {
      "id": 7, "title": "Total no DLQ",
      "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 20, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 50}]}, "mappings": []}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(events_sent_to_dlq_total{reason!=\"\"})", "legendFormat": "DLQ total", "refId": "A"}]
    },

    {
      "id": 10, "title": "Kafka",
      "type": "row", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 12}
    },

    {
      "id": 11, "title": "Consumer lag por partição",
      "description": "Lag crescente = consumer não está acompanhando o producer. Lag zerado = consumo em dia. Requer `docker compose up -d` para iniciar o kafka-exporter.",
      "type": "timeseries", "gridPos": {"h": 8, "w": 14, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "unit": "short", "min": 0, "noValue": "aguardando kafka-exporter"}
      },
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "kafka_consumergroup_lag{consumergroup=\"event-processor\", topic=\"raw-events\"}", "legendFormat": "partição {{partition}}", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(kafka_consumergroup_lag{consumergroup=\"event-processor\", topic=\"raw-events\"})", "legendFormat": "TOTAL", "refId": "B"}
      ]
    },

    {
      "id": 12, "title": "Taxa de produção vs consumo (msgs/s)",
      "description": "Producer rate = msgs chegando no tópico. Consumer rate = msgs commitadas pelo processor. Requer kafka-exporter.",
      "type": "timeseries", "gridPos": {"h": 8, "w": 10, "x": 14, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "unit": "reqps", "min": 0, "noValue": "aguardando kafka-exporter"},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Producer (chegando)"},   "properties": [{"id": "color", "value": {"fixedColor": "blue",  "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "Consumer (consumindo)"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]}
        ]
      },
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(kafka_topic_partition_current_offset{topic=\"raw-events\"}[1m]))",                                       "legendFormat": "Producer (chegando)",   "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(kafka_consumergroup_current_offset{consumergroup=\"event-processor\", topic=\"raw-events\"}[1m]))", "legendFormat": "Consumer (consumindo)", "refId": "B"}
      ]
    },

    {
      "id": 20, "title": "Por Tenant",
      "type": "row", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 21}
    },

    {
      "id": 21, "title": "Processados por tenant (msgs/s)",
      "type": "timeseries", "gridPos": {"h": 8, "w": 14, "x": 0, "y": 22},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 8, "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "unit": "reqps", "min": 0}
      },
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(events_processed_total{tenant_id!=\"\"}[1m])", "legendFormat": "{{tenant_id}}", "refId": "A"}
      ]
    },

    {
      "id": 22, "title": "Top tenants por volume (total)",
      "type": "bargauge", "gridPos": {"h": 8, "w": 10, "x": 14, "y": 22},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "mappings": []}
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "horizontal", "displayMode": "gradient", "valueMode": "color", "showUnfilled": true},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sort_desc(sum by (tenant_id) (events_processed_total{tenant_id!=\"\"}))", "legendFormat": "{{tenant_id}}", "refId": "A"}
      ]
    },

    {
      "id": 30, "title": "Por Tipo de Evento",
      "type": "row", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 30}
    },

    {
      "id": 31, "title": "Processados por tipo de evento (msgs/s)",
      "type": "timeseries", "gridPos": {"h": 8, "w": 14, "x": 0, "y": 31},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 8, "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "unit": "reqps", "min": 0}
      },
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (event_type) (rate(events_processed_total{event_type!=\"\"}[1m]))", "legendFormat": "{{event_type}}", "refId": "A"}
      ]
    },

    {
      "id": 32, "title": "Distribuição por tipo de evento (total)",
      "type": "bargauge", "gridPos": {"h": 8, "w": 10, "x": 14, "y": 31},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "mappings": []}
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "horizontal", "displayMode": "gradient", "valueMode": "color", "showUnfilled": true},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sort_desc(sum by (event_type) (events_processed_total{event_type!=\"\"}))", "legendFormat": "{{event_type}}", "refId": "A"}
      ]
    },

    {
      "id": 40, "title": "Por Producer",
      "type": "row", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 39}
    },

    {
      "id": 41, "title": "Processados por producer (msgs/s)",
      "type": "timeseries", "gridPos": {"h": 8, "w": 14, "x": 0, "y": 40},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 8, "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "unit": "reqps", "min": 0}
      },
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (producer) (rate(events_processed_total{producer!=\"\"}[1m]))", "legendFormat": "{{producer}}", "refId": "A"}
      ]
    },

    {
      "id": 42, "title": "Top producers por volume (total)",
      "type": "bargauge", "gridPos": {"h": 8, "w": 10, "x": 14, "y": 40},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]}, "mappings": []}
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "horizontal", "displayMode": "gradient", "valueMode": "color", "showUnfilled": true},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sort_desc(sum by (producer) (events_processed_total{producer!=\"\"}))", "legendFormat": "{{producer}}", "refId": "A"}
      ]
    },

    {
      "id": 50, "title": "Erros e DLQ",
      "type": "row", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 48}
    },

    {
      "id": 51, "title": "Taxa de erros por razão (msgs/s)",
      "description": "unmarshal_error = JSON inválido | envelope_error = campos obrigatórios ausentes | payload_error = schema do evento não satisfeito",
      "type": "timeseries", "gridPos": {"h": 8, "w": 14, "x": 0, "y": 49},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "bars", "fillOpacity": 80, "lineWidth": 0, "showPoints": "never", "spanNulls": true}, "unit": "reqps", "min": 0}
      },
      "options": {"legend": {"calcs": ["lastNotNull", "max", "sum"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (reason) (rate(events_invalid_total{reason!=\"\"}[1m]))", "legendFormat": "{{reason}}", "refId": "A"}
      ]
    },

    {
      "id": 52, "title": "Erros acumulados por razão",
      "type": "bargauge", "gridPos": {"h": 4, "w": 10, "x": 14, "y": 49},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 50}]}, "mappings": []}
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sort_desc(sum by (reason) (events_invalid_total{reason!=\"\"}))", "legendFormat": "{{reason}}", "refId": "A"}
      ]
    },

    {
      "id": 53, "title": "Falhos + duplicados por tenant (total)",
      "type": "bargauge", "gridPos": {"h": 4, "w": 10, "x": 14, "y": 53},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 10}, {"color": "red", "value": 100}]}, "mappings": []}
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sort_desc(sum by (tenant_id) (events_duplicated_total{tenant_id!=\"\"}) + sum by (tenant_id) (events_failed_total{tenant_id!=\"\"}))",
          "legendFormat": "{{tenant_id}}", "refId": "A"
        }
      ]
    },

    {
      "id": 60, "title": "Latência",
      "type": "row", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 57}
    },

    {
      "id": 61, "title": "Latência de processamento por tipo (p50 / p95 / p99)",
      "description": "Tempo do Handle() por event_type: unmarshal + validação + INSERT no Postgres.",
      "type": "timeseries", "gridPos": {"h": 8, "w": 14, "x": 0, "y": 58},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 5, "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "unit": "s", "min": 0}
      },
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.50, sum by (event_type, le) (rate(event_processing_duration_seconds_bucket{event_type!=\"\"}[1m])))", "legendFormat": "p50 {{event_type}}", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (event_type, le) (rate(event_processing_duration_seconds_bucket{event_type!=\"\"}[1m])))", "legendFormat": "p95 {{event_type}}", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.99, sum by (event_type, le) (rate(event_processing_duration_seconds_bucket{event_type!=\"\"}[1m])))", "legendFormat": "p99 {{event_type}}", "refId": "C"}
      ]
    },

    {
      "id": 62, "title": "Latência atual",
      "type": "stat", "gridPos": {"h": 8, "w": 6, "x": 14, "y": 58},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "ms", "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50}, {"color": "red", "value": 200}]}, "mappings": []}
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "horizontal", "colorMode": "background", "graphMode": "none"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.50, sum by (le) (rate(event_processing_duration_seconds_bucket{event_type!=\"unknown\"}[1m]))) * 1000", "legendFormat": "p50", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (le) (rate(event_processing_duration_seconds_bucket{event_type!=\"unknown\"}[1m]))) * 1000", "legendFormat": "p95", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.99, sum by (le) (rate(event_processing_duration_seconds_bucket{event_type!=\"unknown\"}[1m]))) * 1000", "legendFormat": "p99", "refId": "C"}
      ]
    },

    {
      "id": 63, "title": "Idade das mensagens (OccurredAt → processado)",
      "description": "Atraso entre quando o evento aconteceu e quando foi processado. Alto = consumer lag acumulado.",
      "type": "timeseries", "gridPos": {"h": 8, "w": 4, "x": 20, "y": 58},
